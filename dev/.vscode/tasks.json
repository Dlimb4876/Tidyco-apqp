{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Local Web Server (8000)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.claude\\serve.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "^Serving .+ on http://localhost:8000/$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "problemMatcher": ["$jest"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false
      }
    },
    {
      "label": "Run Tests with Coverage",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--coverage"],
      "problemMatcher": ["$jest"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false
      }
    },
    {
      "label": "Run Tests in Watch Mode",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--watch"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Run Current Test File",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "${relativeFile}"],
      "problemMatcher": ["$jest"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false
      }
    },
    {
      "label": "Validate test file exists",
      "type": "shell",
      "command": "test",
      "args": ["-f", "${file}"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "if (-not (Test-Path '${file}')) { exit 1 }"
        ]
      }
    }
  ]
}
