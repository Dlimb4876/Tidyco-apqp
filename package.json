{
  "name": "tidyco-apqp",
  "version": "1.0.0",
  "type": "module",
  "description": "A Manufacturing Engineering tool for rail overhaul, managing APQP Gates 0–5 and broader operational workflows. Built as a Single Page Application (SPA) using vanilla JavaScript, Chart.js, and Supabase for persistence.",
  "main": "electron/main.js",
  "homepage": "https://github.com/Dlimb4876/Tidyco-apqp#readme",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "check:imports": "node scripts/import-checker.js",
    "check:esm-coverage": "node scripts/esm-coverage.js",
    "lint:npi": "eslint portals/product-development/npi/**/*.js",
    "format:npi": "prettier --write portals/product-development/npi/**/*.js",
    "wiki:build-index": "node scripts/wiki-build-search-index.js",
    "wiki:audit-tokens": "node scripts/wiki-token-audit.js",
    "wiki:check-links": "node scripts/wiki-link-check.js",
    "wiki:check": "npm run wiki:build-index && npm run wiki:audit-tokens && npm run wiki:check-links",
    "check:syntax": "node scripts/syntax-validator.js",
    "check:subscriptions": "node scripts/subscription-cleanup-auditor.js",
    "check:state": "node scripts/state-variable-tracker.js",
    "check:rls": "node scripts/rls-policy-checker.js",
    "check:mobile": "node scripts/mobile-breakpoint-verifier.js",
    "check:modals": "node scripts/modal-state-auditor.js",
    "check:coverage": "node scripts/test-coverage-reporter.js",
    "check:all": "npm run check:syntax && npm run check:imports && npm run check:esm-coverage && npm run check:subscriptions && npm run check:state && npm run check:rls && npm run check:mobile && npm run check:modals && npm run check:coverage",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dlimb4876/Tidyco-apqp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Dlimb4876/Tidyco-apqp/issues"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@playwright/test": "^1.58.2",
    "electron": "^31.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0"
  },
  "build": {
    "appId": "com.tidyco.apqp",
    "productName": "Tidyco APQP",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "electron/main.js",
      "node_modules/"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "Dlimb4876",
              "name": "Tidyco-apqp"
            },
            "draft": true,
            "prerelease": false
          }
        }
      ]
    }
  }
}
