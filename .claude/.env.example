# .claude/.env.example
#
# Copy this file to .claude/.env and fill in your values.
# The .env file is NOT committed to the repo (it is in .gitignore).
#
# Used by .claude/serve.sh and the postgres MCP server in mcp.json.

# Supabase PostgreSQL connection string.
# Find this in your Supabase dashboard → Project Settings → Database → Connection string (URI).
# Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
